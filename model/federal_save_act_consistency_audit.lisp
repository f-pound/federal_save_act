  (and (aud-g-lawp law) (aud-g-qualified-federal-voterp p) (aud-g-protected-right-to-votep constitution-section p) (aud-g-registration-transactionp p x) (aud-g-statute-denies-registrationp law p x) (not (aud-g-valid-regulationp law x))))
(defun aud-g-removal-transactionp (p)
  (and (aud-g-personp p) (aud-g-registered-voterp p)))
(defun aud-g-constitutional-removal-conflict-conditionp (law constitution-section p)
  (and (aud-g-lawp law) (aud-g-qualified-federal-voterp p) (aud-g-protected-right-to-votep constitution-section p) (aud-g-removal-transactionp p) (aud-g-statute-removes-registrantp law p) (not (aud-g-valid-regulationp law p))))
(defun aud-g-voting-transactionp (p b)
  (and (aud-g-personp p) (aud-g-registered-voterp p) (aud-g-ballotp b) (aud-g-votes-in-personp p b)))
