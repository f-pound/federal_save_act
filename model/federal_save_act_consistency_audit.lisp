(defun aud-c-has-supporting-documentp (x)
  (or (aud-c-has-certified-birth-certificatep x) (aud-c-has-hospital-birth-recordp x) (aud-c-has-final-adoption-decreep x) (aud-c-has-consular-report-of-birth-abroadp x) (aud-c-has-naturalization-certificatep x) (aud-c-has-american-indian-card-kicp x)))
(defun aud-c-has-govt-photo-id-with-supporting-docp (x)
  (and (aud-c-has-govt-photo-idp x) (aud-c-has-supporting-documentp x)))
(defun aud-c-has-any-qualifying-documentp (p)
  (or (aud-c-has-real-id-indicating-citizenshipp p) (aud-c-has-valid-us-passportp p) (aud-c-has-military-id-with-us-birthp p) (aud-c-has-govt-photo-id-showing-us-birthp p) (aud-c-has-govt-photo-id-with-supporting-docp p)))
(defun aud-c-qualified-federal-voterp (p)
  (and (aud-c-personp p) (aud-c-citizen-of-usp p) (aud-c-eligible-voterp p)))
(defun aud-c-registration-transactionp (p x)
  (and (aud-c-personp p) (aud-c-voter-registration-applicationp x) (aud-c-attempts-to-registerp p x)))
(defun aud-c-save-act-denial-triggerp (p x)
  (and (aud-c-registration-transactionp p x) (not (aud-c-presents-documentary-proofp p x)) (not (aud-c-alternative-process-approvedp p x))))
(defun aud-c-constitutional-conflict-conditionp (law constitution-section p x)
  (and (aud-c-lawp law) (aud-c-qualified-federal-voterp p) (aud-c-protected-right-to-votep constitution-section p) (aud-c-registration-transactionp p x) (aud-c-statute-denies-registrationp law p x) (not (aud-c-valid-regulationp law x))))
(defun aud-c-removal-transactionp (p)
  (and (aud-c-personp p) (aud-c-registered-voterp p)))
(defun aud-c-constitutional-removal-conflict-conditionp (law constitution-section p)
  (and (aud-c-lawp law) (aud-c-qualified-federal-voterp p) (aud-c-protected-right-to-votep constitution-section p) (aud-c-removal-transactionp p) (aud-c-statute-removes-registrantp law p) (not (aud-c-valid-regulationp law p))))
(defun aud-c-voting-transactionp (p b)
  (and (aud-c-personp p) (aud-c-registered-voterp p) (aud-c-ballotp b) (aud-c-votes-in-personp p b)))
(defun aud-c-ballot-not-countedp (law p b)
  (and (aud-c-statute-denies-regular-ballotp law p b) (not (aud-c-cures-within-deadlinep p b))))
(defun aud-c-constitutional-voting-conflict-conditionp (law constitution-section p b)
  (and (aud-c-lawp law) (aud-c-qualified-federal-voterp p) (aud-c-protected-right-to-votep constitution-section p) (aud-c-voting-transactionp p b) (aud-c-ballot-not-countedp law p b) (not (aud-c-valid-regulationp law b))))

