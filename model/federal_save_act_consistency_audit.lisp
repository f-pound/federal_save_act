  (and (aud-g-lawp law) (aud-g-qualified-federal-voterp p) (aud-g-protected-right-to-votep constitution-section p) (aud-g-voting-transactionp p b) (aud-g-ballot-not-countedp law p b) (not (aud-g-valid-regulationp law b))))

