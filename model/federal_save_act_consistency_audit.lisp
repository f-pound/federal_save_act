  (or (aud-g-has-real-id-indicating-citizenshipp p) (aud-g-has-valid-us-passportp p) (aud-g-has-military-id-with-us-birthp p) (aud-g-has-govt-photo-id-showing-us-birthp p) (aud-g-has-govt-photo-id-with-supporting-docp p)))
