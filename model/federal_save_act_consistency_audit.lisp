   (not (aud-g-presents-valid-photo-idp 'government-fee-waiver-available 'citizen-d 'ballot-d))
   (aud-g-cures-within-deadlinep 'government-fee-waiver-available 'citizen-d 'ballot-d)
   (implies (and (aud-g-signs-attestation-under-perjuryp 'government-fee-waiver-available p) (aud-g-submits-other-evidencep 'government-fee-waiver-available p) (aud-g-attestation-evidence-satisfies-standardsp 'government-fee-waiver-available p x)) (aud-g-alternative-process-approvedp 'government-fee-waiver-available p x))
   (implies (and (aud-g-government-defense-establishedp 'government-fee-waiver-available law) (aud-g-voter-registration-applicationp 'government-fee-waiver-available x)) (aud-g-valid-regulationp 'government-fee-waiver-available law x))
   (aud-g-election-integrity-interestp 'government-fee-waiver-available 'federal-save-act)
   (aud-g-important-government-interestp 'government-fee-waiver-available 'federal-save-act)
   (aud-g-reasonable-registration-requirementp 'government-fee-waiver-available 'federal-save-act)
   (aud-g-registration-procedure-evenhandedp 'government-fee-waiver-available 'federal-save-act)
   (aud-g-documentary-proof-requirement-rationally-connectedp 'government-fee-waiver-available 'federal-save-act)
   (aud-g-adequate-alternative-processp 'government-fee-waiver-available 'federal-save-act)
   (aud-g-burden-not-severep 'government-fee-waiver-available 'federal-save-act p)
   (aud-g-protected-right-to-votep 'government-fee-waiver-available 'amend-v-equal-protection 'citizen-a)
   (aud-g-alternative-process-approvedp 'government-fee-waiver-available 'citizen-a 'registration-attempt-a)
   (implies (aud-g-government-removal-defense-establishedp 'government-fee-waiver-available law p) (aud-g-valid-regulationp 'government-fee-waiver-available law p))
   (aud-g-removal-procedure-evenhandedp 'government-fee-waiver-available 'federal-save-act)
   (implies (and (aud-g-government-voting-defense-establishedp 'government-fee-waiver-available law) (aud-g-ballotp 'government-fee-waiver-available b)) (aud-g-valid-regulationp 'government-fee-waiver-available law b))
   (aud-g-photo-id-requirement-evenhandedp 'government-fee-waiver-available 'federal-save-act)
   (aud-g-provisional-cure-adequatep 'government-fee-waiver-available 'federal-save-act))
  :rule-classes nil)

;;; =========================================================================
;;; JOINT UNSATISFIABILITY of the two registration bridges (propositional):
;;; the challenger needs (not (valid-regulationp law x)) and the government
;;; needs (valid-regulationp law x) for the same application x.  No world
;;; satisfies both, which is why the party books are never loaded together.
;;; =========================================================================
(defthm parties-registration-bridges-jointly-unsatisfiable
  (not (and (implies ci (not v))   ; challenger-bridge-regulation-invalid
            (implies gd v)         ; government-bridge-defense-validates
            ci gd))
  :rule-classes nil)
