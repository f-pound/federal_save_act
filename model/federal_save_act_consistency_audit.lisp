  (implies (and (aud-g-government-voting-defense-establishedp law) (aud-g-ballotp b)) (aud-g-valid-regulationp law b))
  :rule-classes nil)
;; axiom government-photo-id-evenhanded  [federal_save_act_government_model]
(defthm aud-g-government-photo-id-evenhanded
  (aud-g-photo-id-requirement-evenhandedp 'federal-save-act)
  :rule-classes nil)
;; axiom government-provisional-cure-adequate  [federal_save_act_government_model]
(defthm aud-g-government-provisional-cure-adequate
  (aud-g-provisional-cure-adequatep 'federal-save-act)
  :rule-classes nil)

;;; =========================================================================
;;; JOINT UNSATISFIABILITY of the two registration bridges (propositional):
;;; the challenger needs (not (valid-regulationp law x)) and the government
;;; needs (valid-regulationp law x) for the same application x.  No world
;;; satisfies both, which is why the party books are never loaded together.
;;; =========================================================================
(defthm parties-registration-bridges-jointly-unsatisfiable
  (not (and (implies ci (not v))   ; challenger-bridge-regulation-invalid
            (implies gd v)         ; government-bridge-defense-validates
            ci gd))
  :rule-classes nil)
